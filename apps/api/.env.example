# Copie para .env e preencha os valores locais.

PORT=3000
WEB_APP_URL=http://localhost:4200
# Opcional: origens liberadas no CORS, separadas por vírgula. Padrão: WEB_APP_URL.
# CORS_ORIGINS=https://dilirewards.com.br,https://www.dilirewards.com.br

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dili_rewards

# Sessão (JWT)
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Login social — client IDs usados para validar o id_token enviado pelo
# front (Google Identity Services / Sign in with Apple JS). Nenhum client
# secret é necessário nesse fluxo.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# E-mail (Mailjet, Send API v3.1) — "esqueci minha senha" e confirmação de
# e-mail. Sem as chaves, os e-mails não são enviados e as variáveis (com o
# link/código) aparecem só no log da API.
# Chaves em Mailjet > Account settings > API Key Management.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Remetente — o domínio precisa estar validado no Mailjet (SPF e DKIM).
MAIL_FROM_EMAIL=no-reply@dilirewards.com
MAIL_FROM_NAME="Dili Rewards"
# IDs dos templates criados no Mailjet (com "Use template language" ligado).
# Redefinição: {{var:firstName}}, {{var:link}}, {{var:ttlMinutes}}.
MAILJET_TEMPLATE_PASSWORD_RESET=
# Confirmação de e-mail: {{var:firstName}}, {{var:code}}, {{var:ttlMinutes}}.
MAILJET_TEMPLATE_EMAIL_VERIFICATION=
# Opcional: recebe o relatório quando um template falha (variável faltando).
# MAILJET_ERROR_REPORTING_EMAIL=
# Validade do link de redefinição de senha.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Validade do código de confirmação de e-mail.
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# Logs (tabela `logs`, só warn/error): dias guardados antes da limpeza diária.
LOGS_RETENTION_DAYS=30

# Cloudflare R2 — imagens dos produtos da troca de pontos. Sem estas
# variáveis a API sobe, mas o upload de imagem responde 503.
# R2_ACCOUNT_ID: ID da conta Cloudflare (endpoint <id>.r2.cloudflarestorage.com).
# Token de API do R2 com permissão "Object Read & Write" no bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endereço público do bucket (domínio próprio ou https://pub-xxx.r2.dev),
# sem barra no final. A URL gravada no banco é R2_PUBLIC_URL/products/<id>.<ext>.
R2_PUBLIC_URL=
