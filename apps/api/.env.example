# Copie para .env e preencha os valores locais.

PORT=3000
WEB_APP_URL=http://localhost:4200

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dili_rewards

# Sessão (JWT)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Login social — client IDs usados para validar o id_token enviado pelo
# front (Google Identity Services / Sign in with Apple JS). Nenhum client
# secret é necessário nesse fluxo.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
