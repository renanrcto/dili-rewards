# Copie para .env e preencha os valores locais.

PORT=3000
WEB_APP_URL=http://localhost:4200

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dili_rewards

# Sessão (JWT)
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Login social — client IDs usados para validar o id_token enviado pelo
# front (Google Identity Services / Sign in with Apple JS). Nenhum client
# secret é necessário nesse fluxo.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# E-mail (SMTP) — usado no "esqueci minha senha". Sem SMTP_HOST, os e-mails
# não são enviados e o conteúdo (com o link) aparece só no log da API.
SMTP_HOST=
SMTP_PORT=587
# true só para a porta 465 (TLS direto).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dili Rewards <no-reply@dilirewards.com>"
# Validade do link de redefinição de senha.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Logs (tabela `logs`, só warn/error): dias guardados antes da limpeza diária.
LOGS_RETENTION_DAYS=30

# Cloudflare R2 — imagens dos produtos da troca de pontos. Sem estas
# variáveis a API sobe, mas o upload de imagem responde 503.
# R2_ACCOUNT_ID: ID da conta Cloudflare (endpoint <id>.r2.cloudflarestorage.com).
# Token de API do R2 com permissão "Object Read & Write" no bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endereço público do bucket (domínio próprio ou https://pub-xxx.r2.dev),
# sem barra no final. A URL gravada no banco é R2_PUBLIC_URL/products/<id>.<ext>.
R2_PUBLIC_URL=
