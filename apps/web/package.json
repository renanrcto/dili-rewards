{
  "name": "@dilirewards/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "parallelism": false,
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [],
        "options": {
          "cwd": "apps/web",
          "command": "nuxt prepare && vue-tsc --noEmit -p tsconfig.app.json"
        }
      }
    }
  }
}
